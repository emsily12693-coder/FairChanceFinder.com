.cta-btn {
  display: block;
  width: 100%;
  max-width: 260px;
  margin: 12px auto;
  padding: 14px 20px;
  background: var(--teal);
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: transform .15s ease, background .2s ease;
}

.cta-btn:hover {
  transform: scale(1.03);
  background: #00a08f;
}

.cta-btn.secondary {
  background: var(--purple);
}

.cta-btn.secondary:hover {
  background: #8e24aa;
}

.cta-btn.tertiary {
  background: #333;
  color: var(--teal);
  border: 1px solid var(--teal);
}

.cta-btn.tertiary:hover {
  background: #444;
}